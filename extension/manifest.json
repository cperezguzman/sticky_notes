{
  "manifest_version": 3,
  "name": "Sticky Notes Context",
  "version": "1.0.0",
  "description": "Resurface Sticky Notes linked to the site you are browsing.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Sticky Notes Context",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sticky-notes-context@local.dev",
      "strict_min_version": "109.0"
    }
  }
}
